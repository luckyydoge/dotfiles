layout {

    focus-ring {
        active-color   "#745b20"
        inactive-color "#fff8f2"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#745b20"
        inactive-color "#fff8f2"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#745b20"
        inactive-color "#c1a260"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#745b2080"
    }
}

recent-windows {
    highlight {
        active-color "#745b20"
        urgent-color "#ba1a1a"
    }
}
