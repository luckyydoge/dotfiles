layout {

    focus-ring {
        active-color   "#b9192c"
        inactive-color "#fff8f7"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#b9192c"
        inactive-color "#fff8f7"
        urgent-color   "#ba1a1a"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#b9192c"
        inactive-color "#dd3642"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#b9192c80"
    }
}

recent-windows {
    highlight {
        active-color "#b9192c"
        urgent-color "#ba1a1a"
    }
}
