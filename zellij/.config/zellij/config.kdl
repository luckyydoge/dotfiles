// 迁移自 wezterm：Catppuccin Macchiato 配色 + Alt 键位
default_shell "zsh"
copy_command "wl-copy"
default_layout "zjstatus"
// theme "catppuccin-macchiato"

// ui {
//     pane_frames {
//         hide true
//     }
// }
pane_frame_style "full"
pane_frames true
simplified_ui true
stacked_pane_list false
// 必须用名为 emacs 的可执行文件（符号链接 -> emacsclient），zellij 才会补 +N 行号
scrollback_editor "/home/zjw/bin/emacs -t"

keybinds {
    normal {
        bind "Alt t" { NewTab; }
        bind "Alt w" { CloseTab; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
	bind "Ctrl Alt c" { Copy; }
    }
}

theme "noctalia"

